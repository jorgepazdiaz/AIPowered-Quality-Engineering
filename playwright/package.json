{
  "name": "ai-qe-playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:critical": "playwright test --grep @critical",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --project=visual",
    "codegen": "playwright codegen https://practicesoftwaretesting.com",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:boundaries": "playwright test tests/ui/cart-boundaries.spec.ts --project=ui",
    "use:agent-cases": "node -e \"require('fs').copyFileSync('../agents/out/HU-CART-03.boundary.json','data/HU-CART-03.casos.json');console.log('Ahora el test usa los casos del agente')\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
